# Application
# SQLite file path. Use four slashes for an absolute path.
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db

# HTTP check timeout for each probe (seconds)
REQUEST_TIMEOUT_SECONDS=10

# Allowed check interval range and default (seconds)
MIN_CHECK_INTERVAL_SECONDS=10
MAX_CHECK_INTERVAL_SECONDS=3600
DEFAULT_CHECK_INTERVAL_SECONDS=60

# Max concurrent in-flight checks in the worker
CHECK_CONCURRENCY=10

# History retention
HISTORY_RETENTION_DAYS=7
HISTORY_MAX_RECORDS_PER_ENDPOINT=1000

# How often the worker looks for due / force-check endpoints
WORKER_POLL_SECONDS=1

# How long the API waits for the worker after a manual check
MANUAL_CHECK_WAIT_SECONDS=20

# Discard response bodies after this many bytes
MAX_RESPONSE_BYTES=8192

LOG_LEVEL=INFO

# Login is required by default. These optional values create the first user
# automatically, which is convenient for Railway. Users can also sign up in the UI.
AUTH_REQUIRED=true
APP_USERNAME=
APP_PASSWORD=
SESSION_LIFETIME_DAYS=7

# Create one outage alert at this consecutive-failure count, then one recovery alert.
ALERT_FAILURE_THRESHOLD=3

# Optional HTTPS JSON webhook. Leave empty for in-app alerts only.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
